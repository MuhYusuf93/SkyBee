# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# Device-test artifacts stay local; preserve APK copies for closing restoration.
# Existing tracked artifacts require a separate repository/history cleanup.
/docs/evidence/**/*.apk
/docs/evidence/**/*.aab
/docs/evidence/**/*.kasirbackup
/docs/evidence/**/*.db
/docs/evidence/**/*.db-*
/docs/evidence/**/*.sqlite
/docs/evidence/**/*.sqlite3

# Nested plugin Gradle caches are local build metadata, never public sources.
**/.gradle/
