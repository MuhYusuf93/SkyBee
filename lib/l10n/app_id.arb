  "@m53StocktakeHelpBody": {
    "description": "Stocktake message: Drafts are saved without changing stock. A barcode identifies a product type, not each unique piece: the same piece can be counted twice. Choose the physical batch when several exist. Not counted is not 0. After a sale, receipt, product or time zone change, review and recount before finalization. Differences may arise from counting errors, unrecorded transactions, damage or other causes; they are not evidence of theft."
  },
  "@m53StocktakeBatchHelp": {
    "description": "Stocktake message: Choose the correct batch using physical evidence. Quantities here are in base units. Found units retain the observed expiry date, including past dates; costing remains the product moving average."
  },
  "@m53StocktakeBatches": {
    "description": "Stocktake message: Batch observations"
  },
  "@m53StocktakeBatchChoice": {
    "description": "Stocktake message: Several batches exist. Choose the physical batch for +1; this scan has not increased the count."
  },
  "@m53StocktakeNewBatch": {
    "description": "Stocktake message: Add a found physical batch"
  },
  "@m53StocktakeRecount": {
    "description": "Stocktake message: Capture new baseline and recount"
  },
  "@m53StocktakeRecountHelp": {
    "description": "Stocktake message: This product’s counts, entered value and undo will be cleared. Stock and batch baselines will be captured again from current data. Count the physical stock again. Stock is unchanged."
  },
  "@m53StocktakeRemove": {
    "description": "Stocktake message: Remove product from this draft"
  },
  "@m53StocktakeValue": {
    "description": "Stocktake message: Total value of all found stock"
  },
  "@m53StocktakeValueHelp": {
    "description": "Stocktake message: System stock started at 0, so no previous average exists. Enter the TOTAL value for the full counted quantity, not a price per piece or pack. Blank means unknown and is allowed only when purchase cost is optional. Zero requires free-cost confirmation. Review the value again if the count changes. This is not a new purchase or supplier debt."
  },
  "@m53StocktakeValueDifference": {
    "description": "Stocktake message: Estimated value difference"
  },
  "@m53StocktakeFinalize": {
    "description": "Stocktake message: Review and finalize stocktake"
  },
  "@m53StocktakeFinalizeHelp": {
    "description": "Stocktake message: Check every product’s baseline, physical count and difference. Stock, batches, value and history update atomically only if the baseline still matches. Results and reason become permanent snapshots. A shortage is not evidence of theft."
  },
  "@m53StocktakeCancel": {
    "description": "Stocktake message: Cancel stocktake draft"
  },
  "@m53StocktakeCancelHelp": {
    "description": "Stocktake message: Keep the session as cancelled. Stock is unchanged and previous input remains in the cancelled draft."
  },
  "@m53StocktakeEmpty": {
    "description": "Stocktake message: No products yet. Scan a code or include a product without entering a count."
  },
  "@m53StocktakeRegister": {
    "description": "Stocktake message: Product is not registered. Register it with initial stock 0, then include it in the draft and count its physical stock."
  },
  "@m53StocktakeChanged": {
    "description": "Stocktake message: The stocktake draft or page changed. Reload and review your input before retrying."
  },
  "@m53StocktakeConflict": {
    "description": "Stocktake message: Stock, product, batches or time zone changed since the baseline. Open the affected product, capture a new baseline and recount. Old input stays saved until you choose to recount."
  },
  "@m53StocktakeIncomplete": {
    "description": "Stocktake message: Explicitly count every batch before finalizing. Not counted is not 0."
  },
  "@m53StocktakeLineLimit": {
    "description": "Stocktake message: A draft supports up to 100 products. Continue remaining products in another session."
  },
  "@m53StocktakeUntracked": {
    "description": "Stocktake message: This product is untracked; sentinel 999 is not physical stock. Use the tracking activation flow if needed."
  },
  "@m53StocktakeFrozenBatch": {
    "description": "Stocktake message: A baseline batch date cannot be changed by a count. Add a found physical batch if its date differs."
  },
  "@m53StocktakeNothingUndo": {
    "description": "Stocktake message: No count can be undone. Up to the last 50 count changes are retained."
